{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "predeploy": "node scripts/generate-fakenews-photos.js",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "bots/**",
      "scripts/**",
      "*.md",
      "README.txt",
      "memes-incoming/**",
      "app/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "app-manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
